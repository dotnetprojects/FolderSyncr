<Window x:Class="FolderSyncr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FolderSyncr - Folder Comparison and Synchronization"
        Height="760"
        Width="1240"
        MinHeight="700"
        MinWidth="1100"
        Background="#E9ECEF"
        FontFamily="Segoe UI"
        TextElement.Foreground="#111827">
    <Window.Resources>
        <SolidColorBrush x:Key="ChromeBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#BFC7D1" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#D8DEE6" />
        <SolidColorBrush x:Key="HeaderBlueBrush" Color="#0875C9" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5B6472" />
        <SolidColorBrush x:Key="GreenBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="DarkGreenBrush" Color="#15803D" />
        <SolidColorBrush x:Key="ActionGreenBrush" Color="#A7F3B6" />
        <SolidColorBrush x:Key="DeleteBrush" Color="#FCA5A5" />
        <SolidColorBrush x:Key="ConflictBrush" Color="#FDE68A" />

        <Style x:Key="PaneBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PaneHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HeaderBlueBrush}" />
            <Setter Property="Padding" Value="5,3" />
        </Style>

        <Style x:Key="PaneHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#AEB7C2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D1D5DB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainCommandButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="IconButtonContent" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="BorderBrush" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Padding" Value="8,2" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="BorderBrush" Value="#9CA3AF" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLineBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GridLineBrush}" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="AlternatingRowBackground" Value="#F7F7F7" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#ECEFF3" />
            <Setter Property="BorderBrush" Value="#C5CCD5" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="23" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF4FF" />
                </Trigger>
                <DataTrigger Binding="{Binding Kind}" Value="Conflict">
                    <Setter Property="Background" Value="#FFF7D6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionCell" TargetType="Border">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#AEB7C2" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="CopyLeftToRight">
                    <Setter Property="Background" Value="{StaticResource ActionGreenBrush}" />
                    <Setter Property="BorderBrush" Value="#22C55E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="CopyRightToLeft">
                    <Setter Property="Background" Value="{StaticResource ActionGreenBrush}" />
                    <Setter Property="BorderBrush" Value="#22C55E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="DeleteLeft">
                    <Setter Property="Background" Value="{StaticResource DeleteBrush}" />
                    <Setter Property="BorderBrush" Value="#EF4444" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="DeleteRight">
                    <Setter Property="Background" Value="{StaticResource DeleteBrush}" />
                    <Setter Property="BorderBrush" Value="#EF4444" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Conflict">
                    <Setter Property="Background" Value="{StaticResource ConflictBrush}" />
                    <Setter Property="BorderBrush" Value="#D97706" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1">
            <MenuItem Header="_File" />
            <MenuItem Header="_Actions" />
            <MenuItem Header="_Tools" />
            <MenuItem Header="_Help" />
        </Menu>

        <StatusBar DockPanel.Dock="Bottom"
                   Height="26"
                   Background="#F8FAFC"
                   BorderBrush="#BFC7D1"
                   BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="304" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#EEF1F5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="230" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PaneBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="64" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource PaneHeader}">
                            <DockPanel>
                                <TextBlock Text="Configuration" Style="{StaticResource PaneHeaderText}" />
                                <TextBlock DockPanel.Dock="Right" Text="x" Foreground="#FFFFFF" />
                            </DockPanel>
                        </Border>

                        <UniformGrid Grid.Row="1" Columns="5" Margin="5">
                            <Button Style="{StaticResource ToolbarButton}" ToolTip="New configuration">
                                <StackPanel>
                                    <TextBlock Text="+" FontSize="24" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="New" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" ToolTip="Open configuration">
                                <StackPanel>
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#2563EB" HorizontalAlignment="Center" />
                                    <TextBlock Text="Open" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" ToolTip="Save configuration">
                                <StackPanel>
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#374151" HorizontalAlignment="Center" />
                                    <TextBlock Text="Save" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" ToolTip="Refresh session">
                                <StackPanel>
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Reload" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" ToolTip="Save as">
                                <StackPanel>
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#111827" HorizontalAlignment="Center" />
                                    <TextBlock Text="Save as" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Configurations}"
                                  SelectionMode="Single"
                                  SelectedIndex="0"
                                  Margin="1">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Name" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GreenBrush}" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Last sync" Binding="{Binding LastSync}" Width="82" />
                                <DataGridTemplateColumn Header="" Width="32">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#D1D5DB" />

                <Border Grid.Row="2" Style="{StaticResource PaneBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource PaneHeader}">
                            <DockPanel>
                                <TextBlock Text="Overview" Style="{StaticResource PaneHeaderText}" />
                                <TextBlock DockPanel.Dock="Right" Text="x" Foreground="#FFFFFF" />
                            </DockPanel>
                        </Border>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding OverviewRows}"
                                  Margin="1">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Folder" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0"
                                                             Height="14"
                                                             Maximum="100"
                                                             Value="{Binding Percentage}"
                                                             Foreground="#86EFAC"
                                                             Background="#F3F4F6" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#F59E0B" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding Folder}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Items" Binding="{Binding Items}" Width="58" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D1D5DB" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="48" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource ChromeBrush}"
                        BorderBrush="#BFC7D1"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource ToolbarButton}" Margin="8,7,4,7" ToolTip="Comparison settings">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="27" Foreground="#2563EB" />
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource MainCommandButton}" Command="{Binding CompareCommand}" ToolTip="Compare selected folders">
                            <StackPanel Style="{StaticResource IconButtonContent}">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#2563EB" Margin="0,0,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Compare" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="File time and size" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource ToolbarButton}" Margin="4,7" ToolTip="Filter files">
                            <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#B91C1C" />
                        </Button>

                        <Button Grid.Column="4" Style="{StaticResource MainCommandButton}" Command="{Binding SyncCommand}" Margin="4,6,8,6" ToolTip="Start synchronization">
                            <StackPanel Style="{StaticResource IconButtonContent}">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource GreenBrush}" Margin="0,0,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Synchronize" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SelectedMode}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="#F6F7F9"
                        BorderBrush="#BFC7D1"
                        BorderThickness="0,0,0,1"
                        Padding="8,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LeftPath}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="5" Text="{Binding RightPath}" VerticalAlignment="Center" />
                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource SmallButton}" MinWidth="24" Padding="0" ToolTip="Add folder pair">
                            <TextBlock Text="+" FontSize="20" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" />
                        </Button>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SmallButton}" Command="{Binding BrowseLeftCommand}" Content="Browse" />
                        <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource SmallButton}" MinWidth="34" Padding="0" ToolTip="Cloud path">
                            <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" Foreground="#9CA3AF" HorizontalAlignment="Center" />
                        </Button>
                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Style="{StaticResource ToolbarButton}" MinWidth="38" MinHeight="44" Margin="6,0" ToolTip="Swap sides">
                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#374151" />
                        </Button>
                        <TextBox Grid.Row="1" Grid.Column="5" Style="{StaticResource InputBox}" Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="1" Grid.Column="6" Style="{StaticResource SmallButton}" Command="{Binding BrowseRightCommand}" Content="Browse" />
                        <Button Grid.Row="1" Grid.Column="7" Style="{StaticResource SmallButton}" MinWidth="34" Padding="0" ToolTip="Cloud path">
                            <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" Foreground="#9CA3AF" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Column="0"
                              ItemsSource="{Binding Operations}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RelativePath}" Width="36" />
                            <DataGridTextColumn Header="Relative path" Binding="{Binding LeftName}" Width="*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding LeftSize}" Width="92" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Grid.Column="1"
                              ItemsSource="{Binding Operations}"
                              BorderBrush="#9CA3AF"
                              BorderThickness="1,0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="38">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding WillChangeFileSystem}" IsHitTestVisible="False" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action" Width="78">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ActionCell}">
                                            <TextBlock Text="{Binding ActionGlyph}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="#111827" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Grid.Column="2"
                              ItemsSource="{Binding Operations}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Relative path" Binding="{Binding RightName}" Width="*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding RightSize}" Width="92" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Border Grid.Row="3"
                        Background="#F6F7F9"
                        BorderBrush="#BFC7D1"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Button Style="{StaticResource ToolbarButton}" MinHeight="36" MinWidth="42" Margin="0,0,8,0" ToolTip="Toggle overview">
                                <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#2563EB" />
                            </Button>
                            <TextBlock VerticalAlignment="Center" Text="{Binding LeftFileCount, StringFormat={}{0} left files}" />
                            <TextBlock VerticalAlignment="Center" Text="  |  " Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding RightFileCount, StringFormat={}{0} right files}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Select view:" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource ToolbarButton}" MinHeight="34" MinWidth="66" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="==" FontWeight="Bold" FontSize="18" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding TotalCount}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" MinHeight="34" MinWidth="66" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="=>" FontWeight="Bold" FontSize="18" Foreground="{StaticResource DarkGreenBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ChangeCount}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" MinHeight="34" MinWidth="66">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="!" FontWeight="Bold" FontSize="18" Foreground="#B45309" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ConflictCount}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Statistics:" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalCount, StringFormat=Items {0}}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ChangeCount, StringFormat=Changes {0}}" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource DarkGreenBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ConflictCount, StringFormat=Conflicts {0}}" VerticalAlignment="Center" Foreground="#B45309" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
