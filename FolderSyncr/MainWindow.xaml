<Window x:Class="FolderSyncr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syswin="clr-namespace:System.Windows;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:FolderSyncr.ViewModels"
        mc:Ignorable="d"
        Title="FolderSyncr - Folder Comparison and Synchronization"
        Icon="Assets/FolderSyncr.ico"
        Height="760"
        Width="1240"
        MinHeight="700"
        MinWidth="1100"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI"
        TextElement.Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#E9ECEF" />
        <SolidColorBrush x:Key="ChromeBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#F9FAFB" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#BFC7D1" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#D8DEE6" />
        <SolidColorBrush x:Key="HeaderBlueBrush" Color="#0875C9" />
        <SolidColorBrush x:Key="TextBrush" Color="#111827" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5B6472" />
        <SolidColorBrush x:Key="RowAltBrush" Color="#F7F7F7" />
        <SolidColorBrush x:Key="RowHoverBrush" Color="#EAF4FF" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#DBEAFE" />
        <SolidColorBrush x:Key="SelectionTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="ColumnHeaderBrush" Color="#ECEFF3" />
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#DBEAFE" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="ConflictRowBrush" Color="#FFF7D6" />
        <SolidColorBrush x:Key="GreenBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="DarkGreenBrush" Color="#15803D" />
        <SolidColorBrush x:Key="ActionGreenBrush" Color="#A7F3B6" />
        <SolidColorBrush x:Key="DeleteBrush" Color="#FCA5A5" />
        <SolidColorBrush x:Key="ConflictBrush" Color="#FDE68A" />
        <SolidColorBrush x:Key="{x:Static syswin:SystemColors.MenuBrushKey}" Color="#FFFFFF" />
        <SolidColorBrush x:Key="{x:Static syswin:SystemColors.MenuTextBrushKey}" Color="#111827" />
        <SolidColorBrush x:Key="{x:Static syswin:SystemColors.HighlightBrushKey}" Color="#DBEAFE" />
        <SolidColorBrush x:Key="{x:Static syswin:SystemColors.HighlightTextBrushKey}" Color="#111827" />
        <SolidColorBrush x:Key="{x:Static syswin:SystemColors.GrayTextBrushKey}" Color="#6B7280" />

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <vm:BoolToGridLengthConverter x:Key="ConfigurationRowHeightConverter" TrueValue="*" FalseValue="0" />
        <vm:BoolToGridLengthConverter x:Key="OverviewRowHeightConverter" TrueValue="230" FalseValue="0" />

        <Style x:Key="PaneBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PaneHeader" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource HeaderBlueBrush}" />
            <Setter Property="Padding" Value="5,3" />
        </Style>

        <Style x:Key="PaneHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="PaneCloseButton" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D1D5DB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainCommandButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="IconButtonContent" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="3,0" />
        </Style>

        <Style x:Key="PathIconButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="PathSwapButton" TargetType="Button" BasedOn="{StaticResource PathIconButton}">
            <Setter Property="Width" Value="46" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Margin" Value="5,0" />
        </Style>

        <Style x:Key="ConfigToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Height" Value="58" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BottomBarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="BottomIconButton" TargetType="Button" BasedOn="{StaticResource BottomBarButton}">
            <Setter Property="Width" Value="44" />
            <Setter Property="MinWidth" Value="44" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
        </Style>

        <ControlTemplate x:Key="TopLevelMenuHeaderTemplate" TargetType="{x:Type MenuItem}">
            <Grid>
                <Border x:Name="HeaderBorder"
                        Background="{TemplateBinding Background}"
                        Padding="6,3">
                    <ContentPresenter ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
                <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            Padding="2">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="TopLevelMenuItemTemplate" TargetType="{x:Type MenuItem}">
            <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    Padding="6,3">
                <ContentPresenter ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="{x:Type MenuItem}">
            <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    Padding="34,5,34,5"
                    MinWidth="190">
                <ContentPresenter ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
            <Grid>
                <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        Padding="34,5,24,5"
                        MinWidth="190">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <TextBlock Grid.Column="1"
                                   Text=">"
                                   Foreground="{TemplateBinding Foreground}"
                                   Margin="14,0,0,0" />
                    </Grid>
                </Border>
                <Popup x:Name="PART_Popup"
                       Placement="Right"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            Padding="2">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource TopLevelMenuHeaderTemplate}" />
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource TopLevelMenuItemTemplate}" />
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource SubmenuHeaderTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource RowAltBrush}" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ColumnHeaderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="23" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <EventSetter Event="MouseDoubleClick" Handler="OperationRow_MouseDoubleClick" />
            <EventSetter Event="ContextMenuOpening" Handler="OperationRow_ContextMenuOpening" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Kind}" Value="Conflict">
                    <Setter Property="Background" Value="{DynamicResource ConflictRowBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionCell" TargetType="Border">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#AEB7C2" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="CopyLeftToRight">
                    <Setter Property="Background" Value="{StaticResource ActionGreenBrush}" />
                    <Setter Property="BorderBrush" Value="#22C55E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="CopyRightToLeft">
                    <Setter Property="Background" Value="{StaticResource ActionGreenBrush}" />
                    <Setter Property="BorderBrush" Value="#22C55E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="DeleteLeft">
                    <Setter Property="Background" Value="{StaticResource DeleteBrush}" />
                    <Setter Property="BorderBrush" Value="#EF4444" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="DeleteRight">
                    <Setter Property="Background" Value="{StaticResource DeleteBrush}" />
                    <Setter Property="BorderBrush" Value="#EF4444" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Conflict">
                    <Setter Property="Background" Value="{StaticResource ConflictBrush}" />
                    <Setter Property="BorderBrush" Value="#D97706" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="_New configuration" Command="{Binding NewConfigurationCommand}" />
                <MenuItem Header="_Open configuration" Command="{Binding OpenConfigurationCommand}" />
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveConfigurationCommand}" />
                <MenuItem Header="Save _as" Command="{Binding SaveAsConfigurationCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Actions">
                <MenuItem Header="_Compare" Command="{Binding CompareCommand}" />
                <MenuItem Header="_Synchronize" Command="{Binding SyncCommand}" />
                <MenuItem Header="_Cancel" Command="{Binding CancelCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Show _Configuration" Command="{Binding ShowConfigurationCommand}" />
                <MenuItem Header="Show _Overview" Command="{Binding ShowOverviewCommand}" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Reload configuration list" Command="{Binding ReloadConfigurationCommand}" />
                <MenuItem Header="Open FreeFileSync _log" Command="{Binding OpenFreeFileSyncLogCommand}" />
                <MenuItem Header="Create _sample data" Command="{Binding CreateSampleDataCommand}" />
                <MenuItem Header="_Toggle light/dark mode" Command="{Binding ToggleThemeCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Documentation" Command="{Binding OpenDocumentationCommand}" />
                <MenuItem Header="_About FolderSyncr" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom"
                   Height="26"
                   Background="{DynamicResource PanelBrush}"
                   BorderBrush="{DynamicResource BorderBrushSoft}"
                   BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="304" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{DynamicResource ChromeBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding IsConfigurationVisible, Converter={StaticResource ConfigurationRowHeightConverter}}" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="{Binding IsOverviewVisible, Converter={StaticResource OverviewRowHeightConverter}}" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource PaneBorder}"
                        Visibility="{Binding IsConfigurationVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="64" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource PaneHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Configuration" Style="{StaticResource PaneHeaderText}" />
                                <Button Grid.Column="1" Style="{StaticResource PaneCloseButton}" Command="{Binding CloseConfigurationCommand}" ToolTip="Close Configuration pane">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" />
                                </Button>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="1" Columns="5" Margin="5">
                            <Button Style="{StaticResource ConfigToolbarButton}" Command="{Binding NewConfigurationCommand}" ToolTip="New configuration">
                                <StackPanel>
                                    <TextBlock Text="+" FontSize="24" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="New" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ConfigToolbarButton}" Command="{Binding OpenConfigurationCommand}" ToolTip="Open configuration">
                                <StackPanel>
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#2563EB" HorizontalAlignment="Center" />
                                    <TextBlock Text="Open" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ConfigToolbarButton}" Command="{Binding SaveConfigurationCommand}" ToolTip="Save configuration">
                                <StackPanel>
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#374151" HorizontalAlignment="Center" />
                                    <TextBlock Text="Save" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ConfigToolbarButton}" Command="{Binding ReloadConfigurationCommand}" ToolTip="Refresh session">
                                <StackPanel>
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Reload" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ConfigToolbarButton}" Command="{Binding SaveAsConfigurationCommand}" ToolTip="Save as">
                                <StackPanel>
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#111827" HorizontalAlignment="Center" />
                                    <TextBlock Text="Save as" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Configurations}"
                                  SelectionMode="Single"
                                  SelectedIndex="0"
                                  Margin="1">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Name" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GreenBrush}" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Last sync" Binding="{Binding LastSync}" Width="82" />
                                <DataGridTemplateColumn Header="" Width="32">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              Background="#D1D5DB"
                              Visibility="{Binding IsLeftPaneSplitterVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Border Grid.Row="2"
                        Style="{StaticResource PaneBorder}"
                        Visibility="{Binding IsOverviewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource PaneHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Overview" Style="{StaticResource PaneHeaderText}" />
                                <Button Grid.Column="1" Style="{StaticResource PaneCloseButton}" Command="{Binding CloseOverviewCommand}" ToolTip="Close Overview pane">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" />
                                </Button>
                            </Grid>
                        </Border>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding OverviewRows}"
                                  Margin="1">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Folder" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0"
                                                             Height="14"
                                                             Maximum="100"
                                                             Value="{Binding Percentage}"
                                                             Foreground="#86EFAC"
                                                             Background="#F3F4F6" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#F59E0B" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding Folder}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Items" Binding="{Binding Items}" Width="58" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D1D5DB" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="86" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="48" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource ChromeBrush}"
                        BorderBrush="#BFC7D1"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource ToolbarButton}" MinHeight="58" MinWidth="64" Margin="8,10,4,10" Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Comparison settings">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="27" Foreground="#2563EB" />
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource MainCommandButton}" Command="{Binding CompareCommand}" ToolTip="Compare selected folders">
                            <StackPanel Style="{StaticResource IconButtonContent}">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#2563EB" Margin="0,0,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Compare" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SelectedCompareMethod}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource MainCommandButton}" MinWidth="150" HorizontalAlignment="Right" Margin="4,10,12,10" Command="{Binding ToggleThemeCommand}" ToolTip="Switch between light and dark mode">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ThemeButtonText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource ToolbarButton}" MinHeight="58" MinWidth="64" Margin="4,10" Command="{Binding DataContext.OpenFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Filter files">
                            <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#B91C1C" />
                        </Button>

                        <Button Grid.Column="4" Style="{StaticResource MainCommandButton}" Command="{Binding SyncCommand}" Margin="4,10,8,10" ToolTip="Start synchronization">
                            <StackPanel Style="{StaticResource IconButtonContent}">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource GreenBrush}" Margin="0,0,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Synchronize" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SelectedMode}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{DynamicResource ChromeBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1"
                        Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LeftPath}" VerticalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="5" Text="{Binding RightPath}" VerticalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource MutedTextBrush}" />
                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource PathIconButton}" Command="{Binding NewConfigurationCommand}" ToolTip="Add folder pair">
                            <TextBlock Text="+" FontSize="20" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" />
                        </Button>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputBox}" Margin="6,0" Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}" AllowDrop="True" Tag="Left" PreviewDragOver="PathBox_PreviewDragOver" Drop="PathBox_Drop" />
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SmallButton}" Command="{Binding BrowseLeftCommand}" Content="Browse" />
                        <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource PathIconButton}" Command="{Binding DataContext.CloudPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Cloud path">
                            <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" Foreground="#9CA3AF" HorizontalAlignment="Center" />
                        </Button>
                        <Button Grid.Row="1" Grid.Column="4" Style="{StaticResource PathSwapButton}" Command="{Binding DataContext.SwapSidesCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Swap sides">
                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#374151" />
                        </Button>
                        <TextBox Grid.Row="1" Grid.Column="5" Style="{StaticResource InputBox}" Margin="6,0" Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}" AllowDrop="True" Tag="Right" PreviewDragOver="PathBox_PreviewDragOver" Drop="PathBox_Drop" />
                        <Button Grid.Row="1" Grid.Column="6" Style="{StaticResource SmallButton}" Command="{Binding BrowseRightCommand}" Content="Browse" />
                        <Button Grid.Row="1" Grid.Column="7" Style="{StaticResource PathIconButton}" Command="{Binding DataContext.CloudPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Cloud path">
                            <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" Foreground="#9CA3AF" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Column="0"
                              ItemsSource="{Binding OperationsView}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RelativePath}" Width="36" />
                            <DataGridTextColumn Header="Relative path" Binding="{Binding LeftName}" Width="*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding LeftSize}" Width="92" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Grid.Column="1"
                              ItemsSource="{Binding OperationsView}"
                              BorderBrush="#9CA3AF"
                              BorderThickness="1,0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="38">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelectedForSync, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelectForSync}"
                                                  HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action" Width="78">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ActionCell}">
                                            <TextBlock Text="{Binding ActionGlyph}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="#111827" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Grid.Column="2"
                              ItemsSource="{Binding OperationsView}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Relative path" Binding="{Binding RightName}" Width="*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding RightSize}" Width="92" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Border Grid.Row="3"
                        Background="{DynamicResource ChromeBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" MinWidth="455" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Button Style="{StaticResource BottomIconButton}" Command="{Binding ShowOverviewCommand}" ToolTip="Show Overview pane">
                                <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#2563EB" />
                            </Button>
                            <TextBlock VerticalAlignment="Center" Text="{Binding LeftFileCount, StringFormat={}{0} left files}" />
                            <TextBlock VerticalAlignment="Center" Text="  |  " Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding RightFileCount, StringFormat={}{0} right files}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Select view:" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource BottomBarButton}" Command="{Binding ShowAllOperationsCommand}" ToolTip="Show all items">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="*" FontWeight="Bold" FontSize="18" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding TotalCount}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BottomBarButton}" Command="{Binding ShowEqualOperationsCommand}" ToolTip="Show equal items">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="==" FontWeight="Bold" FontSize="18" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding EqualCount}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BottomBarButton}" Command="{Binding ShowCopyLeftToRightOperationsCommand}" ToolTip="Show left-to-right copies">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="=>" FontWeight="Bold" FontSize="18" Foreground="{StaticResource DarkGreenBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding CopyLeftToRightCount}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BottomBarButton}" Command="{Binding ShowCopyRightToLeftOperationsCommand}" ToolTip="Show right-to-left copies">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&lt;=" FontWeight="Bold" FontSize="18" Foreground="{StaticResource DarkGreenBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding CopyRightToLeftCount}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BottomBarButton}" Command="{Binding ShowDeleteLeftOperationsCommand}" ToolTip="Show left deletes">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="X&lt;" FontWeight="Bold" FontSize="18" Foreground="#DC2626" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding DeleteLeftCount}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BottomBarButton}" Command="{Binding ShowDeleteRightOperationsCommand}" ToolTip="Show right deletes">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&gt;X" FontWeight="Bold" FontSize="18" Foreground="#DC2626" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding DeleteRightCount}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BottomBarButton}" Command="{Binding ShowConflictOperationsCommand}" ToolTip="Show conflicts" Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="!" FontWeight="Bold" FontSize="18" Foreground="#B45309" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ConflictCount}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Stats:" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalCount, StringFormat=Items {0}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ChangeCount, StringFormat=Changes {0}}" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource DarkGreenBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ConflictCount, StringFormat=Conflicts {0}}" VerticalAlignment="Center" Foreground="#B45309" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
